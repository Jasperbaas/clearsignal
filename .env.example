# Required
ANTHROPIC_API_KEY=
PARALLEL_API_KEY=

# Optional: models (defaults shown)
CS_MODEL=claude-sonnet-5-5
CS_MODEL_FAST=claude-haiku-5-5

# Optional: limits per visitor per hour, and for the whole site per day
CS_AI_PER_HOUR=40
CS_SEARCH_PER_HOUR=40
CS_AI_PER_DAY=800
CS_SEARCH_PER_DAY=800

# Optional: shared rate-limit counts across server instances (Upstash Redis, free tier is enough).
# The Vercel Marketplace integration sets KV_REST_API_URL and KV_REST_API_TOKEN, which work too.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
